# =====================================================
# MEDICINE AUTOMATION - ENVIRONMENT VARIABLES
# =====================================================

# =====================================================
# AI PROVIDER SELECTION
# =====================================================

# Choose your AI provider: ollama, groq, together, openrouter, gemini
AI_PROVIDER=ollama

# =====================================================
# OLLAMA (100% FREE - LOCAL)
# =====================================================

# Ollama runs locally on your M1 Mac - completely free!
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Alternative models:
# - sroecker/sauerkrautlm-7b-hero (best German)
# - llama3.2:3b (fast, multilingual, small)
# - aya (23 languages including German)

# =====================================================
# GROQ (500k tokens/day FREE - CLOUD)
# =====================================================

# Get free API key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Alternative models:
# - llama-3.1-8b-instant (fastest)
# - llama-3.1-70b-versatile (best quality)
# - mixtral-8x7b-32768 (good balance)

# =====================================================
# TOGETHER AI ($100 free credits)
# =====================================================

# Sign up: https://www.together.ai/
TOGETHER_API_KEY=
TOGETHER_MODEL=deepseek-ai/DeepSeek-R1
# Alternative models:
# - deepseek-ai/DeepSeek-R1 (cheapest: $0.27/1M tokens)
# - meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo (fast)
# - mistralai/Mistral-7B-Instruct-v0.1 (good German)

# =====================================================
# OPENROUTER (Free models + paid options)
# =====================================================

# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free
# Free models:
# - meta-llama/llama-4-maverick:free
# - google/gemini-2.5-pro:free
# - mistralai/mistral-small-3.1:free
# - deepseek/deepseek-r1:free

# =====================================================
# GOOGLE GEMINI (requires billing setup)
# =====================================================

# Get at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =====================================================
# MUSIC GENERATION (Optional)
# =====================================================

# Mubert API (FREE tier) - Optional for now
MUBERT_LICENSE=

# =====================================================
# COMFYUI SETTINGS
# =====================================================

# ComfyUI Server URL (local M1 Mac)
COMFYUI_URL=http://localhost:8188
COMFYUI_API_KEY=

# =====================================================
# N8N SETTINGS
# =====================================================

# n8n Webhook URL (for external triggers)
N8N_WEBHOOK_URL=http://localhost:5678

# n8n Basic Auth
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=medicine2025secure

# =====================================================
# ARCHIVE.ORG SETTINGS
# =====================================================

# Archive.org doesn't require API key
ARCHIVE_ORG_EMAIL=

# =====================================================
# VIDEO GENERATION SETTINGS
# =====================================================

# Video format
VIDEO_FORMAT=mp4
VIDEO_RESOLUTION=1080x1920
VIDEO_FPS=24
VIDEO_DURATION_MIN=30
VIDEO_DURATION_MAX=60

# TTS Settings (Coqui XTTS)
TTS_LANGUAGE=de
TTS_VOICE_GENDER=neutral
TTS_SPEED=1.0

# Music Settings
MUSIC_STYLE=ambient,asmr,calm,mystical
MUSIC_VOLUME=0.3

# =====================================================
# CONTENT SETTINGS
# =====================================================

# Daily production target
VIDEOS_PER_DAY=1

# Content language
SOURCE_LANGUAGE=de
OUTPUT_LANGUAGE=de

# Script settings
SCRIPT_WORD_COUNT_MIN=140
SCRIPT_WORD_COUNT_MAX=160
SCRIPT_DURATION_TARGET=50

# =====================================================
# STORAGE SETTINGS
# =====================================================

# Temporary file retention (days)
TEMP_FILES_RETENTION_DAYS=7

# Output storage path
OUTPUT_PATH=/home/user/medicine/output

# Data storage path
DATA_PATH=/home/user/medicine/data

# =====================================================
# AUTOMATION SETTINGS
# =====================================================

# Workflow trigger time (cron format)
CRON_SCHEDULE=0 9 * * *

# Enable automatic processing (false for now, enable after testing)
AUTO_PROCESS=false

# Enable manual review checkpoint
MANUAL_REVIEW=true

# =====================================================
# ERROR HANDLING
# =====================================================

# Email notifications (optional)
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_ADDRESS=

# Slack notifications (optional)
SLACK_WEBHOOK_URL=

# Max retries for failed tasks
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# =====================================================
# DEBUGGING
# =====================================================

# Enable debug mode
DEBUG_MODE=false

# Save intermediate files for debugging
SAVE_INTERMEDIATE_FILES=true

# Log level
LOG_LEVEL=info

# =====================================================
# COST TRACKING (Optional)
# =====================================================

# Track API costs (for paid providers)
TRACK_COSTS=true
MONTHLY_BUDGET_LIMIT=10

# =====================================================
# NOTES
# =====================================================
# RECOMMENDED SETUP FOR ZERO COST:
# 1. Set AI_PROVIDER=ollama
# 2. Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 3. Download model: ollama pull llama3.2:3b
# 4. That's it! Everything else is optional.
#
# ALTERNATIVE FREE SETUP:
# 1. Set AI_PROVIDER=groq
# 2. Get free API key at https://console.groq.com/
# 3. Set GROQ_API_KEY=your_key_here
# 4. Get 500,000 tokens/day free!
# =====================================================
