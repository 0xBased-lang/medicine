# =====================================================
# MEDICINE AUTOMATION - ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your values

# =====================================================
# AI SERVICES
# =====================================================

# Google Gemini API (FREE tier - 1M tokens/day)
# Get at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backup LLM: DeepSeek V3 (if you need more capacity)
# Get at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# =====================================================
# MUSIC GENERATION
# =====================================================

# Mubert API (FREE tier)
# Get at: https://mubert.com/developers
MUBERT_LICENSE=your_mubert_license_here

# Alternative: Aimi (if Mubert limits reached)
# Get at: https://aimi.fm/
AIMI_API_KEY=your_aimi_api_key_here

# =====================================================
# COMFYUI SETTINGS
# =====================================================

# ComfyUI Server URL (local M1 Mac)
COMFYUI_URL=http://localhost:8188
COMFYUI_API_KEY=  # Leave empty for local setup

# =====================================================
# N8N SETTINGS
# =====================================================

# n8n Webhook URL (for external triggers)
N8N_WEBHOOK_URL=http://localhost:5678

# n8n Basic Auth (optional, for security)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password

# =====================================================
# ARCHIVE.ORG SETTINGS
# =====================================================

# Archive.org doesn't require API key, but you can set email for identification
ARCHIVE_ORG_EMAIL=your_email@example.com

# =====================================================
# VIDEO GENERATION SETTINGS
# =====================================================

# Video format
VIDEO_FORMAT=mp4
VIDEO_RESOLUTION=1080x1920  # Vertical for shorts
VIDEO_FPS=24
VIDEO_DURATION_MIN=30  # seconds
VIDEO_DURATION_MAX=60  # seconds

# TTS Settings (Coqui XTTS)
TTS_LANGUAGE=de  # de=German, en=English
TTS_VOICE_GENDER=neutral  # male, female, neutral
TTS_SPEED=1.0  # 0.8-1.2 recommended

# Music Settings
MUSIC_STYLE=ambient,asmr,calm,mystical
MUSIC_VOLUME=0.3  # 0.0-1.0 (low volume for voiceover)

# =====================================================
# CONTENT SETTINGS
# =====================================================

# Daily production target
VIDEOS_PER_DAY=1

# Content language
SOURCE_LANGUAGE=de  # German source texts
OUTPUT_LANGUAGE=de  # de=German videos, en=English videos

# Script settings
SCRIPT_WORD_COUNT_MIN=140
SCRIPT_WORD_COUNT_MAX=160
SCRIPT_DURATION_TARGET=50  # seconds

# =====================================================
# STORAGE SETTINGS
# =====================================================

# Temporary file retention (days)
TEMP_FILES_RETENTION_DAYS=7

# Output storage path
OUTPUT_PATH=/home/user/medicine/output

# Data storage path
DATA_PATH=/home/user/medicine/data

# =====================================================
# AUTOMATION SETTINGS
# =====================================================

# Workflow trigger time (cron format)
# Default: 9:00 AM daily
CRON_SCHEDULE=0 9 * * *

# Enable automatic processing (true/false)
AUTO_PROCESS=false  # Set to true for full automation

# Enable manual review checkpoint (true/false)
MANUAL_REVIEW=true  # Set to false to skip review

# =====================================================
# ERROR HANDLING
# =====================================================

# Email notifications (optional)
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_ADDRESS=your_email@example.com

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Max retries for failed tasks
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60

# =====================================================
# DEBUGGING
# =====================================================

# Enable debug mode (verbose logging)
DEBUG_MODE=false

# Save intermediate files for debugging
SAVE_INTERMEDIATE_FILES=true

# Log level (info, debug, error)
LOG_LEVEL=info

# =====================================================
# PLATFORM SETTINGS (Future Use)
# =====================================================

# TikTok (for auto-posting - future feature)
TIKTOK_API_KEY=
TIKTOK_SECRET=

# Twitter (for auto-posting - future feature)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Instagram (for auto-posting - future feature)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# =====================================================
# NOTES
# =====================================================
# - Start with just GEMINI_API_KEY for MVP
# - All other services are optional or self-hosted (free)
# - Set AUTO_PROCESS=false initially for manual review
# - Keep MANUAL_REVIEW=true until you trust the output
# =====================================================
