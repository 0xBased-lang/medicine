  "archive_org_api": {
    "base_url": "https://archive.org/advancedsearch.php",
    "output_format": "json",
    "fields": [
      "identifier",
      "title",
      "creator",
      "date",
      "language",
      "subject",
      "description",
      "mediatype",
      "format",
      "downloads",
      "publicdate"
    ],
    "sort": [
      "downloads desc",
      "publicdate desc"
    ],
    "rows": 50,
    "page": 1
  },

  "filtering_criteria": {
    "min_downloads": 10,
    "min_pages": 20,
    "max_pages": 1000,
    "exclude_keywords": [
      "modern",
      "zeitgenössisch",
      "21. Jahrhundert",
      "pharmazie lehrbuch",
      "medizinstudium",
      "anatomie"
    ],
    "require_text_layer": true,
    "public_domain_only": true
  },

  "content_quality_filters": {
    "ocr_quality_check": true,
    "language_detection": true,
    "min_text_quality_score": 0.7,
    "skip_damaged_pages": true
  },

  "rotation_strategy": {
    "description": "Rotate through search strategies to find diverse content",
    "mode": "round_robin",
    "strategies_per_day": 2,
    "min_days_between_repeats": 7
  },

  "example_queries": {
    "basic_german_herbalism": "language:ger AND (Kräuterkunde OR Heilpflanzen) AND mediatype:texts",
    "historical_medicine": "language:ger AND (Heilkunde OR Medizin) AND date:[1400 TO 1900] AND mediatype:texts",
    "shamanic_practices": "(Schamanismus OR shamanism) AND (Heilung OR healing) AND mediatype:texts",
    "germanic_traditions": "(germanische OR germanic OR norse) AND (Heilung OR medicine OR herbs) AND mediatype:texts"
  },

  "notes": [
    "Search terms are optimized for Archive.org's search engine",
    "Combines German and English terms for broader coverage",
    "Filters ensure only accessible, quality texts are selected",
    "Priority determines search order (1=highest)",
    "Rotation strategy prevents repetitive content"
  ]
